{
  "name": "discovery-service",
  "version": "1.0.0",
  "description": "BMC asset discovery service with PostgreSQL integration",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
